Cell["\<\
This demonstrates that there are 3 connected components, 3 holes, and no \
enclosed voids in the teapot. Indeed.\
\>", "ExampleText",
 CellChangeTimes->{{3.9925122833769455`*^9, 3.992512305560955*^9}},
 CellID->733876855,ExpressionUUID->"05f41285-d5e7-344c-bcd0-56b282d5f948"]
