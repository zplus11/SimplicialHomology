Cell[TextData[{
 "A homology group is represented as ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    SuperscriptBox[
     ButtonBox["Integers",
      BaseStyle->"Link"], 
     StyleBox["i", "TI"]], ",", 
    RowBox[{
     ButtonBox["CyclicGroup",
      BaseStyle->"Link"], "[", 
     SubscriptBox[
      StyleBox["j", "TI"], 
      StyleBox["1", "TR"]], "]"}], ",", 
    RowBox[{
     ButtonBox["CyclicGroup",
      BaseStyle->"Link"], "[", 
     SubscriptBox[
      StyleBox["j", "TI"], 
      StyleBox["2", "TR"]], "]"}], ",", "\[Ellipsis]"}], "}"}]], 
  "InlineFormula",ExpressionUUID->"78bc417e-f8ab-924b-864a-f2ed6b6dab1e"],
 " which are the direct product components of the group."
}], "Notes",
 CellChangeTimes->{{3.9924880464012375`*^9, 3.9924880967379017`*^9}, {
  3.9924881290112724`*^9, 3.992488203869978*^9}, {3.9924882444007874`*^9, 
  3.992488258584738*^9}},
