Cell[CellGroupData[{
Cell["RandomSimplicialComplex", "ObjectName",
 CellID->55879556,ExpressionUUID->"20ef31c2-e61e-bc4f-9a59-449e413215e4"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9f24aac4-0984-0a4a-9c20-bc609875ce4f"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["RandomSimplicialComplex",
    BaseStyle->"Link",
    ButtonData->
     "paclet:Taggar/SimplicialHomology/ref/RandomSimplicialComplex"], "[", 
   RowBox[{
    StyleBox["n", "TI"], ",", 
    StyleBox["d", "TI"], ",", 
    StyleBox["p", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "8c896bdf-f4b1-8544-b05c-d06e8f98e72b"],
 " \[LineSeparator]generates a random ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",ExpressionUUID->
  "2d89fd6b-637a-d944-892a-d49dc617a539"],
 "-dimensional simplicial complex on ",
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "5ce46835-c355-6549-a970-c8277678e692"],
 " vertices."
}], "Usage",
 CellChangeTimes->{{3.9965400059944324`*^9, 3.9965400386659336`*^9}},
 CellID->154289734,ExpressionUUID->"1675ea13-01f2-d74b-8126-b16597ffc44a"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["n", "TI"]], "InlineFormula",ExpressionUUID->
  "607e044d-d6d0-e540-9395-f5e2b95530fc"],
 " specifies the number of vertices of the simplicial complex; ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",ExpressionUUID->
  "b78a2706-1acd-4642-b4f0-8435b3248010"],
 " specifies the dimension of the simplicial complex; and ",
 Cell[BoxData[
  RowBox[{"0", "\[LessSlantEqual]", 
   StyleBox["p", "TI"], "\[LessSlantEqual]", "1"}]], "InlineFormula",
  ExpressionUUID->"63ce531a-c6fd-1941-9838-dc67789b3d6e"],
 " specifies the probability that each possible ",
 Cell[BoxData[
  StyleBox["d", "TI"]], "InlineFormula",ExpressionUUID->
  "0dd2e912-505a-2f42-8243-c1467fea36ae"],
 "-simplex is included. The default value for ",
 Cell[BoxData[
  StyleBox["p", "TI"]], "InlineFormula",ExpressionUUID->
  "c30c4a84-1019-5548-8063-285b434a8d8b"],
 " is 1/2."
}], "Notes",
 CellChangeTimes->{{3.99654006623357*^9, 3.996540165183956*^9}},
 CellID->737560618,ExpressionUUID->"52aed0ac-3316-7f4b-a70f-a37a15c320a2"]
}, Open  ]],

