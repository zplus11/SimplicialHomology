        RowBox[{
         RowBox[{"k", "[", "\"\<EulerCharacteristic\>\"", "]"}], 
         RowBox[{"l", "[", "\"\<EulerCharacteristic\>\"", "]"}]}]}]}]}], 
     "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"{", "100", "}"}]}], "]"}]}]], "Input",
