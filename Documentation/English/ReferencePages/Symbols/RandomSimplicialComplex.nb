 RowBox[{"And", "@@", 
  RowBox[{"Table", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"With", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"k", "=", 
         RowBox[{"RandomSimplicialComplex", "[", 
          RowBox[{"7", ",", "2"}], "]"}]}], ",", 
        RowBox[{"l", "=", 
         RowBox[{"RandomSimplicialComplex", "[", 
          RowBox[{"5", ",", "3"}], "]"}]}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"SimplicialJoin", "[", 
         RowBox[{"k", ",", "l"}], "]"}], "[", "\"\<EulerCharacteristic\>\"", 
        "]"}], "==", 
       RowBox[{
        RowBox[{"k", "[", "\"\<EulerCharacteristic\>\"", "]"}], "+", 
