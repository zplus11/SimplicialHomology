Cell[CellGroupData[{
Cell["SimplicialComplex", "ObjectName",
 CellID->436811951,ExpressionUUID->"8024971a-af64-b849-a927-aaae0bb1d779"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"08e2db20-313d-874e-bb99-11dd31a255a0"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SimplicialComplex",
    BaseStyle->"Link",
    ButtonData->"paclet:Taggar/SimplicialHomology/ref/SimplicialComplex"], "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      ButtonBox["Simplex",
       BaseStyle->"Link"], "[", "\[Ellipsis]", "]"}], ",", 
     RowBox[{
      ButtonBox["Simplex",
       BaseStyle->"Link"], "[", "\[Ellipsis]", "]"}], ",", "..."}], "}"}], 
   "]"}]], "InlineFormula",ExpressionUUID->
  "35254dbe-7f5c-6d48-ac3c-b3f92a988017"],
 " \[LineSeparator]constructs the simplicial complex generated by the given ",
 Cell[BoxData[
  ButtonBox["Simplex",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "deec5e40-2afb-be48-8f7a-c4942134eb75"],
 " objects.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"d0b5e7c3-a16e-c64f-8aca-a1cb4e15c88c"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SimplicialComplex",
    BaseStyle->"Link",
    ButtonData->"paclet:Taggar/SimplicialHomology/ref/SimplicialComplex"], "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", "\[Ellipsis]", "}"}], ",", 
     RowBox[{"{", "\[Ellipsis]", "}"}], ",", "..."}], "}"}], "]"}]], 
  "InlineFormula",ExpressionUUID->"26323d65-5ae3-c247-8277-2232bb49ca2c"],
 "\[LineSeparator]constructs the simplicial complex generated by the given ",
 Cell[BoxData[
  ButtonBox["List",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "397ef1de-d641-f247-a54f-7b38ba6501f0"],
 " objects.\n",
 Cell["   ", "ModInfo",ExpressionUUID->"8cd13040-b1fa-1048-9e37-773ba5b35777"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SimplicialComplex",
    BaseStyle->"Link",
    ButtonData->"paclet:Taggar/SimplicialHomology/ref/SimplicialComplex"], "[", 
   StyleBox["mesh", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "60082c9b-6c8d-9c46-8a05-3503e6c98b1f"],
 "\[LineSeparator]constructs the simplicial complex from ",
 Cell[BoxData[
  StyleBox["mesh", "TI"]], "InlineFormula",ExpressionUUID->
  "c65f4e98-8c8b-bb44-8790-37720ac8ed2e"],
 " given by a ",
 Cell[BoxData[
  ButtonBox["MeshRegion",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "d7b041f4-9807-4d46-983b-0fb2c3cbf92a"],
 " or a ",
 Cell[BoxData[
  ButtonBox["BoundaryMeshRegion",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "e33713f0-8f44-e441-ba25-3338786f7295"],
 ".\n",
 Cell["   ", "ModInfo",ExpressionUUID->"50001572-539e-0540-b55d-e66185ac4fd7"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SimplicialComplex",
    BaseStyle->"Link",
    ButtonData->"paclet:Taggar/SimplicialHomology/ref/SimplicialComplex"], "[", 
   StyleBox["name", "TI"], "]"}]], "InlineFormula",ExpressionUUID->
  "bef02a95-4f9c-5249-9ad7-30a280019624"],
 "\[LineSeparator]constructs the simplicial complex from given ",
 Cell[BoxData[
  StyleBox["name", "TI"]], "InlineFormula",ExpressionUUID->
  "22617028-ffc1-d844-9b11-1685d1918a08"],
 " specification."
}], "Usage",
 CellChangeTimes->{{3.9923127651633816`*^9, 3.9923127803138924`*^9}, {
