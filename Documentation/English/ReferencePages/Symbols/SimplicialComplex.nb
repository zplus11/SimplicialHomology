Cell[TextData[{
 "Simplicial complex is a union of ",
 Cell[BoxData[
  ButtonBox["Simplex",
   BaseStyle->"Link"]], "InlineFormula",ExpressionUUID->
  "08d4237d-758e-a346-a621-6592f9b8286e"],
 "es (simplices) that constitute it."
}], "Notes",
 CellChangeTimes->{{3.992321049398571*^9, 3.992321100017845*^9}, {
  3.9923212971059856`*^9, 3.9923212971059856`*^9}, {3.992392356995718*^9, 
  3.992392358089468*^9}},
 CellID->196086519,ExpressionUUID->"e22cf3b0-1e7c-f749-b717-47eae4c3649d"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   ButtonBox["Simplex",
    BaseStyle->"Link"], "[", "\[Ellipsis]", "]"}]], "InlineFormula",
  ExpressionUUID->"840ba65c-300d-dc49-9360-0e05baed943c"],
 " or ",
 Cell[BoxData[
  RowBox[{"{", "\[Ellipsis]", "}"}]], "InlineFormula",ExpressionUUID->
  "ae8dc79a-fa00-0e40-9a40-264aa1421611"],
 " inputs must be orderable, e.g., integers."
}], "Notes",
 CellChangeTimes->{{3.9925685938908844`*^9, 3.9925686326758194`*^9}},
 CellID->609343299,ExpressionUUID->"ba86bd68-1893-6b49-ae74-e39868a6d90c"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["SimplicialComplex",
   BaseStyle->"Link",
   ButtonData->"paclet:Taggar/SimplicialHomology/ref/SimplicialComplex"]], 
  "InlineFormula",ExpressionUUID->"7df5002f-b14e-8642-86d0-0a4e14176534"],
 " automatically adds the closure of the supplied simplices."
}], "Notes",
 CellChangeTimes->{{3.992332060044424*^9, 3.9923320993309574`*^9}},
 CellID->20370248,ExpressionUUID->"c3715f0d-7921-8041-ad04-46c015d39781"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["SimplicialComplex",
   BaseStyle->"Link",
   ButtonData->"paclet:Taggar/SimplicialHomology/ref/SimplicialComplex"]], 
  "InlineFormula",ExpressionUUID->"02fea7cf-ad3e-3b48-add5-eb7fa6cee0d1"],
 "[\[Ellipsis]][\"FVector\"] returns ",
 Cell[BoxData[
  RowBox[{"(", 
   RowBox[{
    SubscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["0", "TR"]], ",", 
    SubscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["1", "TR"]], ",", "\[Ellipsis]", ",", 
    SubscriptBox[
     StyleBox["f", "TI"], 
     StyleBox["d", "TI"]]}], ")"}]], "InlineFormula",ExpressionUUID->
  "d90504bb-58b6-3e4a-acbe-e3936b0cb080"],
 " where ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["f", "TI"], 
   StyleBox["i", "TI"]]], "InlineFormula",ExpressionUUID->
  "e5808a2c-5ede-604e-9857-84ddf5b00db0"],
 " denotes the number of ",
 Cell[BoxData[
  StyleBox["i", "TI"]], "InlineFormula",ExpressionUUID->
  "c37bd0dc-fdc7-ef42-9470-cd2cdabc6802"],
 "-dimensional simplices."
}], "Notes",
 CellChangeTimes->{{3.992333217263357*^9, 3.9923333747870502`*^9}, {
  3.992391712927387*^9, 3.992391718415886*^9}},
 CellID->444619100,ExpressionUUID->"a71fc09f-50cd-ca40-a2ff-79aab0a8ac7d"],

