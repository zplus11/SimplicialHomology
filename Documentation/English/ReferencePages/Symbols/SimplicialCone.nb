   RowBox[{
    RowBox[{
     SubscriptBox["f", "k"], "(", 
     RowBox[{"C", " ", 
      RowBox[{"(", 
       StyleBox["sc", "TI"], ")"}]}], ")"}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["f", "k"], "(", 
      StyleBox["sc", "TI"], ")"}], "+", 
     RowBox[{
      SubscriptBox["f", 
       RowBox[{"k", "-", "1"}]], "(", 
      StyleBox["sc", "TI"], ")"}]}]}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"c8bc7629-f79b-fd4d-95eb-b436f92d1696"],
