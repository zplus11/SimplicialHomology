  SubscriptBox[
   StyleBox["sc", "TI"], "2"]], "InlineFormula",ExpressionUUID->
  "32b9a150-61b1-3443-a022-ccfb97f2aae2"],
 " is denoted by ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox[
    StyleBox["sc", "TI"], "1"], "*", 
   SubscriptBox[
    StyleBox["sc", "TI"], "2"]}]], "InlineFormula",ExpressionUUID->
  "cd61a450-1532-f146-bf10-347d912af22f"],
 ", and so on."
}], "Notes",
 CellChangeTimes->{{3.992481276406065*^9, 3.9924813313875656`*^9}},
