Cell["\<\
The simplicial join is formed by taking pairwise union of all simplices of \
the given complexes.\
\>", "Notes",
 CellChangeTimes->{{3.9924810575209923`*^9, 3.992481105393484*^9}},
 CellID->246664447,ExpressionUUID->"c43c4f8d-9bd5-1e4c-ba30-eb4f7ddf11ff"],

Cell[TextData[{
