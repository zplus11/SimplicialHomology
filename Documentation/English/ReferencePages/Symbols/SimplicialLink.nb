Cell["SimplicialLink", "ObjectName",
 CellID->588452038,ExpressionUUID->"532dfd5a-fcc5-a546-b306-22580465b213"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"923fa6a9-ce6e-1040-b162-221a52138ef9"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SimplicialLink",
    BaseStyle->"Link",
    ButtonData->"paclet:TaggarSimplicialHomology/ref/SimplicialLink"], "[", 
   RowBox[{
    StyleBox["sc", "TI"], ",", 
    StyleBox["sigma", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "80d58b97-dd4c-5447-baf8-3529b5205c81"],
 "\[LineSeparator]returns the link of ",
 Cell[BoxData[
  StyleBox["sigma", "TI"]], "InlineFormula",ExpressionUUID->
  "557bdc73-5554-644d-b736-d4e8774e8b8c"],
 " in ",
 Cell[BoxData[
  StyleBox["sc", "TI"]], "InlineFormula",ExpressionUUID->
  "b1172ad0-b0f9-c742-945b-8ce094997d1e"],
 "."
}], "Usage",
 CellChangeTimes->{{3.994548239656542*^9, 3.9945482397190437`*^9}},
 CellID->6378887,ExpressionUUID->"c1f9bffb-a8ba-1644-a52f-06bc4881d822"],

Cell[TextData[{
 Cell[BoxData[
  StyleBox["sc", "TI"]], "InlineFormula",ExpressionUUID->
  "eaf90688-0926-964b-bc16-56d274c0c106"],
 " must be a ",
 Cell[BoxData[
  ButtonBox["SimplicialComplex",
   BaseStyle->"Link",
   ButtonData->"paclet:Taggar/SimplicialHomology/ref/SimplicialComplex"]], 
  "InlineFormula",ExpressionUUID->"4c61322f-48a1-3541-bef9-9a757640fd36"],
 " and ",
 Cell[BoxData[
  StyleBox["sigma", "TI"]], "InlineFormula",ExpressionUUID->
  "0f02322f-3d2b-d943-b870-271b0b41b76b"],
 " must be a simplex in ",
 Cell[BoxData[
  StyleBox["sc", "TI"]], "InlineFormula",ExpressionUUID->
  "88f4df64-020e-0a43-b2b5-286851716159"],
 "."
}], "Notes",
 CellChangeTimes->{{3.9945478260820675`*^9, 3.994547856563425*^9}},
 CellID->356284652,ExpressionUUID->"f1abe07e-900d-5340-84f3-f16bbafdceb9"],

Cell[TextData[{
 "Link of ",
 Cell[BoxData[
  StyleBox["sigma", "TI"]], "InlineFormula",ExpressionUUID->
  "ef14968f-f4a7-4e4b-9b36-1876ec5de7e3"],
 " is the complex formed by all simplices that are disjoint from ",
 Cell[BoxData[
  StyleBox["sigma", "TI"]], "InlineFormula",ExpressionUUID->
  "132465c4-bca7-7f41-92fa-33fec8404d3e"],
 " and whose union with ",
 Cell[BoxData[
  StyleBox["sigma", "TI"]], "InlineFormula",ExpressionUUID->
  "2305ffc9-1242-684e-82bd-d9a19b356582"],
 " is a simplex of the complex."
}], "Notes",
 CellChangeTimes->{{3.994548306975994*^9, 3.9945483866286297`*^9}},
 CellID->66622799,ExpressionUUID->"1f55fff9-5807-dd44-92a2-59671c0a8c53"]
}, Open  ]],

