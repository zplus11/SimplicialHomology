Cell[TextData[{
 Cell[BoxData[
  StyleBox["sc", "TI"]], "InlineFormula",ExpressionUUID->
  "8e7830f0-efb3-174e-8cfe-43559546c178"],
 " must be a ",
 Cell[BoxData[
  ButtonBox["SimplicialComplex",
   BaseStyle->"Link",
   ButtonData->"paclet:Taggar/SimplicialHomology/ref/SimplicialComplex"]], 
  "InlineFormula",ExpressionUUID->"be5295b6-d782-0a44-8aeb-2714a009e2cf"],
