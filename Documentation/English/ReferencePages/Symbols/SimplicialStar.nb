Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"376c8fa9-2e48-6645-b435-977dce7be5bd"],
 Cell[BoxData[
  RowBox[{
   ButtonBox["SimplicialStar",
    BaseStyle->"Link",
    ButtonData->"paclet:TaggarSimplicialHomology/ref/SimplicialStar"], "[", 
   RowBox[{
    StyleBox["sc", "TI"], ",", 
    StyleBox["sigma", "TI"]}], "]"}]], "InlineFormula",ExpressionUUID->
  "658aea65-7f38-6145-883b-0245bbf85983"],
 "\[LineSeparator]returns the star of ",
 Cell[BoxData[
  StyleBox["sigma", "TI"]], "InlineFormula",ExpressionUUID->
  "72a1efba-8514-f64c-8633-308af0fe598b"],
 " in ",
