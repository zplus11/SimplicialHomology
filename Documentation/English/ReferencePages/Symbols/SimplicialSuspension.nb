Cell[TextData[{
 "Regarding f-Vectors, we have that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["f", "k"], "(", 
     RowBox[{"S", " ", 
      RowBox[{"(", 
       StyleBox["sc", "TI"], ")"}]}], ")"}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["f", "k"], "(", 
      StyleBox["sc", "TI"], ")"}], "+", 
     RowBox[{"2", 
      RowBox[{
       SubscriptBox["f", 
        RowBox[{"k", "-", "1"}]], "(", 
       StyleBox["sc", "TI"], ")"}]}]}]}], TraditionalForm]], "InlineMath",
  ExpressionUUID->"cd6c33f2-0b45-0c4f-923b-2436865751fd"],
 ":"
}], "ExampleText",
